<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Building Management System (BMS)</title>

    <!-- Google Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BMS.styles.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideHeaderNav"] == null)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2">
                <div class="container-fluid px-4">
                    <a class="navbar-brand fw-bold text-primary d-flex align-items-center me-4" asp-area="" asp-controller="Home" asp-action="Index">
                        <div class="rounded-3 bg-primary text-white p-2 d-inline-flex me-2 shadow-sm" style="line-height: 1;">
                            <i class="bi bi-building fs-5"></i>
                        </div>
                        <span class="fs-4 tracking-tight">BMS</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bmsNavbarCollapse" aria-controls="bmsNavbarCollapse"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="bmsNavbarCollapse">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                            <!-- Dashboard -->
                            <li class="nav-item me-1">
                                <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1 text-primary"></i> Dashboard
                                </a>
                            </li>

                            <!-- Module 1: Buildings Dropdown -->
                            <li class="nav-item dropdown me-1">
                                <a class="nav-link dropdown-toggle px-3" href="#" id="buildingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-building me-1 text-indigo"></i> Buildings
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm rounded-3 mt-2" aria-labelledby="buildingsDropdown">
                                    <li><a class="dropdown-item py-2" asp-controller="Buildings" asp-action="Index"><i class="bi bi-list-ul me-2"></i> All Buildings</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Buildings" asp-action="Create"><i class="bi bi-plus-circle me-2"></i> Add New Building</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Buildings" asp-action="Types"><i class="bi bi-tags me-2"></i> Building Types</a></li>
                                </ul>
                            </li>

                            <!-- Module 2: Property Units Dropdown -->
                            <li class="nav-item dropdown me-1">
                                <a class="nav-link dropdown-toggle px-3" href="#" id="unitsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-grid-3x3-gap me-1 text-info"></i> Units (Floors, Rooms, Shops)
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm rounded-3 mt-2" aria-labelledby="unitsDropdown">
                                    <li><h6 class="dropdown-header text-uppercase fs-xs">Floors</h6></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Floors" asp-action="Index"><i class="bi bi-layers me-2"></i> View Floors</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-uppercase fs-xs">Rooms & Apartments</h6></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Rooms" asp-action="Index"><i class="bi bi-door-open me-2"></i> View Rooms</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Rooms" asp-action="Create"><i class="bi bi-plus-lg me-2"></i> Create Room</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-uppercase fs-xs">Commercial Spaces</h6></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Shops" asp-action="Index"><i class="bi bi-shop me-2"></i> View Shops</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Shops" asp-action="Create"><i class="bi bi-plus-lg me-2"></i> Create Shop</a></li>
                                </ul>
                            </li>

                            <!-- Module 3: Rentals & Tenants Dropdown -->
                            <li class="nav-item dropdown me-1">
                                <a class="nav-link dropdown-toggle px-3" href="#" id="rentalsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-file-earmark-text me-1 text-success"></i> Rentals & Tenants
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm rounded-3 mt-2" aria-labelledby="rentalsDropdown">
                                    <li><h6 class="dropdown-header text-uppercase fs-xs">Inquiries & Applications</h6></li>
                                    <li><a class="dropdown-item py-2" asp-controller="RentalRequests" asp-action="Index"><i class="bi bi-inbox me-2"></i> Rental Requests</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="RentalRequests" asp-action="ShopRequests"><i class="bi bi-shop-window me-2"></i> Shop Requests</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-uppercase fs-xs">Lease Management</h6></li>
                                    <li><a class="dropdown-item py-2" asp-controller="RoomRentals" asp-action="Index"><i class="bi bi-key me-2"></i> Active Leases</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="RoomRentals" asp-action="Create"><i class="bi bi-plus-circle me-2"></i> New Lease Agreement</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="RoomRentals" asp-action="Terminations"><i class="bi bi-x-circle me-2"></i> Lease Terminations</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-uppercase fs-xs">Tenants</h6></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Tenants" asp-action="Index"><i class="bi bi-people me-2"></i> Tenant Directory</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Tenants" asp-action="Create"><i class="bi bi-person-plus me-2"></i> Register Tenant</a></li>
                                </ul>
                            </li>
                        </ul>

                        <ul class="navbar-nav align-items-center">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle fw-semibold d-flex align-items-center" href="#" id="userProfileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <div class="rounded-circle bg-light border p-1 me-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                            <i class="bi bi-person-fill text-secondary"></i>
                                        </div>
                                        <span>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm rounded-3 mt-2" aria-labelledby="userProfileDropdown">
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                <button type="submit" class="dropdown-item text-danger py-2"><i class="bi bi-box-arrow-right me-2"></i> Log Out</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-outline-primary btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Login">Log In</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-primary btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Register">Register</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container-fluid px-4 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 bg-white mt-auto">
        <div class="container text-center fs-sm">
            &copy; 2026 - Building Management System (BMS) - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
