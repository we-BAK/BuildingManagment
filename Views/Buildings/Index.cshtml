@model IEnumerable<BMS.Models.Building>

@{
    ViewData["Title"] = "Buildings Directory";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Buildings Directory</h1>
        <p class="page-header-subtitle">Manage all registered commercial, residential, and mixed-use real estate assets</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-bms-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Register New Building
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Building Name</th>
                        <th>Classification Type</th>
                        <th>Location</th>
                        <th>Floors</th>
                        <th>Total Units</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No buildings registered yet. Click "Register New Building" to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@b.Name</div>
                                    <small class="text-muted">ID: #BLD-@b.Id</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-tag me-1 text-primary"></i>@(b.BuildingType?.Name ?? "Unclassified")
                                    </span>
                                </td>
                                <td><i class="bi bi-geo-alt text-muted me-1"></i>@(b.Location ?? "N/A")</td>
                                <td><span class="fw-semibold">@b.Floors.Count</span> Floors</td>
                                <td><span class="fw-semibold">@(b.Rooms.Count + b.Shops.Count)</span> Units (@b.Rooms.Count Rooms, @b.Shops.Count Shops)</td>
                                <td>
                                    @if (b.IsActive)
                                    {
                                        <span class="badge-status badge-status-active"><i class="bi bi-check-circle"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-declined"><i class="bi bi-x-circle"></i> Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-primary" title="In-depth details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-outline-secondary" title="Edit building info">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Images" asp-route-id="@b.Id" class="btn btn-outline-info" title="Manage gallery & floor plans">
                                            <i class="bi bi-image"></i>
                                        </a>
                                        <a asp-action="Specifications" asp-route-id="@b.Id" class="btn btn-outline-dark" title="Technical specs">
                                            <i class="bi bi-sliders"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
