@model BMS.Models.ViewModels.ShopSpecViewModel

@{
    ViewData["Title"] = $"Technical Requirements: Shop {Model.ShopNumber}";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Technical Requirements & Utility Specs</h1>
        <p class="page-header-subtitle">Specify electrical power capacity, HVAC ventilation, plumbing access, and commercial utility standards for <strong>Shop @Model.ShopNumber</strong></p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.ShopId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Details
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-plus-circle me-2 text-primary"></i> Add Utility / Tech Spec</h5>
            </div>
            <div class="bms-card-body">
                <form asp-action="SaveSpecification" method="post">
                    <input type="hidden" asp-for="ShopId" />

                    <div class="form-group-custom">
                        <label asp-for="FeatureName" class="form-label-custom">Requirement Title <span class="text-danger">*</span></label>
                        <input asp-for="FeatureName" class="form-control" placeholder="e.g. Electrical Power Load" autofocus style="height: 48px; border-radius: 10px;" />
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="FeatureValue" class="form-label-custom">Specification Value <span class="text-danger">*</span></label>
                        <input asp-for="FeatureValue" class="form-control" placeholder="e.g. 3-Phase 100A Service" style="height: 48px; border-radius: 10px;" />
                    </div>

                    <button type="submit" class="btn btn-bms-primary w-100 mt-3">
                        <i class="bi bi-check-lg me-1"></i> Save Requirement
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-cpu me-2 text-dark"></i> Configured Specifications (@Model.ExistingSpecifications.Count)</h5>
            </div>
            <div class="bms-card-body p-0">
                <div class="table-responsive">
                    <table class="bms-table">
                        <thead>
                            <tr>
                                <th>Requirement Title</th>
                                <th>Specification Detail</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ExistingSpecifications.Any())
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">No technical specs configured for this shop unit yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var spec in Model.ExistingSpecifications)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@spec.Name</td>
                                        <td><span class="badge bg-light text-primary border fs-6">@spec.NumberOfFloor</span></td>
                                        <td><span class="badge-status badge-status-active">Active</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>