@using System.Reflection
@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Notification Center";

    object? GetProp(object? obj, params string[] names)
    {
        if (obj == null) return null;
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null) return prop.GetValue(obj);
        }
        return null;
    }
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">System Notifications</h1>
        <p class="page-header-subtitle">Real-time alerts for maintenance requests, financial updates, and contract approvals</p>
    </div>
    <div>
        <form asp-action="MarkAllAsRead" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-check2-all me-1"></i> Mark All Read
            </button>
        </form>
    </div>
</div>

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="list-group list-group-flush">
            @if (Model == null || !Model.Any())
            {
                <div class="p-4 text-center">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <i class="bi bi-bell-slash text-muted fs-1"></i>
                        <h6 class="text-dark fw-bold mb-0">No Alerts Found</h6>
                        <p class="text-muted small mb-0">You are completely up to date with all system notifications.</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var n in Model)
                {
                    var id = GetProp(n, "Id") ?? 0;
                    var title = GetProp(n, "Title", "Subject")?.ToString() ?? "System Update";
                    var message = GetProp(n, "Message", "Description", "Content")?.ToString() ?? "Update details provided.";
                    var isRead = GetProp(n, "IsRead", "Read") as bool? ?? false;
                    var category = GetProp(n, "Category", "Type")?.ToString()?.ToLower() ?? "info";
                    var rawDate = GetProp(n, "CreatedAt", "CreatedDate", "Timestamp");
                    var timeStr = rawDate is DateTime dt ? dt.ToString("MMM dd, yyyy - hh:mm tt") : (rawDate?.ToString() ?? "Recently");

                    var icon = category.Contains("finance") || category.Contains("payment") ? "bi-cash-coin text-success" :
                    category.Contains("maintenance") || category.Contains("request") ? "bi-wrench text-warning" :
                    category.Contains("termination") || category.Contains("alert") ? "bi-exclamation-triangle text-danger" : "bi-info-circle text-primary";

                    <div class="list-group-item p-3 border-bottom d-flex align-items-start justify-content-between @(!isRead ? "bg-light" : "")">
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded bg-white shadow-sm border">
                                <i class="bi @icon fs-4"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 text-dark fw-bold">@title</h6>
                                <p class="mb-1 text-muted small">@message</p>
                                <small class="text-muted fs-7"><i class="bi bi-clock me-1"></i>@timeStr</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (!isRead)
                            {
                                <form asp-action="MarkAsRead" asp-route-id="@id" method="post">
                                    <button type="submit" class="btn btn-sm btn-link text-decoration-none p-0" title="Mark as read">
                                        <i class="bi bi-check-circle text-primary fs-5"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>