@model BMS.Models.ViewModels.BuildingImageUploadViewModel

@{
    ViewData["Title"] = $"Building Photos: {Model.BuildingName}";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Gallery & Floor Plans</h1>
        <p class="page-header-subtitle">Manage high-resolution images, architectural diagrams, and floor plan blueprints for <strong>@Model.BuildingName</strong></p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.BuildingId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Building Details
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Upload Form Card -->
    <div class="col-lg-4">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-upload me-2 text-primary"></i> Add Image or Blueprint</h5>
            </div>
            <div class="bms-card-body">
                <form asp-action="UploadImage" method="post">
                    <input type="hidden" asp-for="BuildingId" />

                    <div class="form-group-custom">
                        <label asp-for="ImageUrl" class="form-label-custom">Image File URL / Path <span class="text-danger">*</span></label>
                        <div class="input-icon-group">
                            <i class="bi bi-link-45deg input-leading-icon"></i>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/building-photo.jpg" autofocus />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Description" class="form-label-custom">Caption / Description</label>
                        <input asp-for="Description" class="form-control" placeholder="e.g. Front facade exterior view" style="height: 48px; border-radius: 10px;" />
                    </div>

                    <button type="submit" class="btn btn-bms-primary w-100 mt-3">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Save Image
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Existing Gallery Images -->
    <div class="col-lg-8">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-images me-2 text-info"></i> Uploaded Gallery Photos (@Model.ExistingImages.Count)</h5>
            </div>
            <div class="bms-card-body">
                @if (!Model.ExistingImages.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-image fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        No images uploaded for this building yet. Use the upload panel to attach photos.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                                    <img src="@img.Url" class="card-img-top" alt="Building media" style="height: 160px; object-fit: cover;" />
                                    <div class="card-body p-2 text-center">
                                        <small class="text-muted d-block text-truncate">Image #@img.Id</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}