@using System.Reflection
@model IEnumerable<BMS.Models.Tenant>

@{
    ViewData["Title"] = "Tenant Directory";

    object? GetProp(object? obj, params string[] names)
    {
        if (obj == null) return null;
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null) return prop.GetValue(obj);
        }
        return null;
    }
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Tenant Directory</h1>
        <p class="page-header-subtitle">Directory of active and past commercial & residential tenants, identification, and contact info</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-bms-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i> Register New Tenant
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Tenant Name</th>
                        <th>National ID / Passport</th>
                        <th>Email Contact</th>
                        <th>Phone Number</th>
                        <th>Active Contracts</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No tenants registered. Click "Register New Tenant" to add one.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in Model)
                        {
                            var firstName = GetProp(t, "FirstName", "Name", "FullName")?.ToString() ?? "";
                            var middleName = GetProp(t, "MiddleName")?.ToString() ?? "";
                            var lastName = GetProp(t, "LastName")?.ToString() ?? "";

                            var tenantName = $"{firstName} {middleName} {lastName}".Trim();
                            if (string.IsNullOrWhiteSpace(tenantName))
                            {
                                var userObj = GetProp(t, "User", "ApplicationUser", "Account");
                                tenantName = GetProp(userObj, "FullName", "UserName", "Email")?.ToString() ?? "Tenant";
                            }

                            var idCard = GetProp(t, "IdentityCardNumber", "NationalId", "PassportNumber", "IdCard", "IdentityNumber")?.ToString() ?? "N/A";
                            var email = GetProp(t, "Email", "EmailAddress")?.ToString() ?? GetProp(GetProp(t, "User"), "Email")?.ToString() ?? "N/A";
                            var phone = GetProp(t, "Phone", "PhoneNumber", "Mobile")?.ToString() ?? GetProp(GetProp(t, "User"), "PhoneNumber")?.ToString() ?? "N/A";

                            var roomRentals = GetProp(t, "RoomRentals", "Rentals", "Contracts", "Leases") as System.Collections.IEnumerable;
                            int activeCount = 0;
                            if (roomRentals != null)
                            {
                                foreach (var r in roomRentals)
                                {
                                    var isActive = GetProp(r, "IsActive") as bool? ?? true;
                                    var isDeleted = GetProp(r, "IsDeleted") as bool? ?? false;
                                    if (isActive && !isDeleted) activeCount++;
                                }
                            }

                            var tenantId = GetProp(t, "Id") ?? "0";

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@tenantName</div>
                                    <small class="text-muted">Tenant #TNT-@tenantId</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@idCard</span></td>
                                <td><i class="bi bi-envelope text-muted me-1"></i>@email</td>
                                <td><i class="bi bi-telephone text-muted me-1"></i>@phone</td>
                                <td>
                                    @if (activeCount > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border">@activeCount Active Lease(s)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">No Active Lease</span>
                                    }
                                </td>
                                <td><span class="badge-status badge-status-active">Active</span></td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@tenantId" class="btn btn-outline-secondary btn-sm rounded-2"><i class="bi bi-pencil me-1"></i> Edit Profile</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>