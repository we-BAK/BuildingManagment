@model BMS.Models.Invoice
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="bi bi-file-earmark-text text-primary me-2"></i>Invoice #@Model.Id
    </h1>
    <div>
        <button onclick="window.print()" class="btn btn-outline-secondary me-2">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <a asp-action="Index" class="btn btn-light border shadow-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 invoice-card">
    <div class="card-body p-5">
        <!-- Invoice Header -->
        <div class="row border-bottom pb-4 mb-4">
            <div class="col-sm-6">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-3 bg-primary text-white p-2 d-inline-flex me-2 shadow-sm" style="line-height: 1;">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                    <span class="fs-3 fw-bold tracking-tight text-primary">BMS Property</span>
                </div>
                <address class="text-muted mb-0">
                    123 Business Avenue, Suite 100<br>
                    Metropolis, NY 10001<br>
                    contact@bmsproperty.com<br>
                    (555) 123-4567
                </address>
            </div>
            <div class="col-sm-6 text-sm-end mt-4 mt-sm-0">
                <h4 class="text-uppercase fw-bold text-muted mb-3">Invoice</h4>
                <div class="row mb-1">
                    <div class="col-6 col-sm-8 fw-semibold text-muted">Invoice No:</div>
                    <div class="col-6 col-sm-4 text-dark fw-bold">#@Model.Id</div>
                </div>
                <div class="row mb-1">
                    <div class="col-6 col-sm-8 fw-semibold text-muted">Invoice Date:</div>
                    <div class="col-6 col-sm-4">@Model.InvoiceDate.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="row mb-1">
                    <div class="col-6 col-sm-8 fw-semibold text-muted">Due Date:</div>
                    <div class="col-6 col-sm-4">@Model.DueDate.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-6 col-sm-8 fw-semibold text-muted">Status:</div>
                    <div class="col-6 col-sm-4">
                        @{
                            var statusClass = Model.InvoiceStatus?.Name switch
                            {
                                "Paid" => "bg-success",
                                "Unpaid" => "bg-warning text-dark",
                                "Overdue" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@(Model.InvoiceStatus?.Name ?? "Unknown")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Billing Info -->
        <div class="row mb-5">
            <div class="col-12">
                <h6 class="text-uppercase fw-bold text-muted mb-3">Bill To:</h6>
                <h5 class="fw-bold mb-1">@(Model.User?.FullName ?? "Unknown User")</h5>
                <address class="text-muted">
                    Email: @(Model.User?.Email ?? "N/A")<br>
                    <!-- Additional tenant address info can go here -->
                </address>
            </div>
        </div>

        <!-- Invoice Items (Simplified for this model) -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Description</th>
                        <th class="text-end" style="width: 150px;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="fw-bold">General Billing</div>
                            <small class="text-muted">Charges as per lease agreement or service request.</small>
                        </td>
                        <td class="text-end align-middle">@Model.Amount.ToString("C")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="row justify-content-end">
            <div class="col-sm-5 col-md-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold text-muted">Subtotal:</span>
                    <span>@Model.Amount.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
                    <span class="fw-semibold text-muted">Tax (0%):</span>
                    <span>$0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-5 fw-bold">Total:</span>
                    <span class="fs-4 fw-bold text-primary">@Model.Amount.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @Html.Raw("@media print {")
    body { background-color: #fff; }
    .navbar, header, footer, .btn { display: none !important; }
    .container-fluid { padding: 0 !important; }
    .card { border: none !important; box-shadow: none !important; }
    .invoice-card { margin: 0 !important; padding: 0 !important; }
    @Html.Raw("}")
</style>
