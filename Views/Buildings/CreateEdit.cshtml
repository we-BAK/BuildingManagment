@model BMS.Models.ViewModels.BuildingFormViewModel

@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Building" : "Register Building";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header-container">
            <div>
                <h1 class="page-header-title">@(isEdit ? "Edit Building Profile" : "Register New Building")</h1>
                <p class="page-header-subtitle">Provide building details, classification type, and address location</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Buildings
                </a>
            </div>
        </div>

        <div class="bms-card">
            <div class="bms-card-body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <div class="form-group-custom mb-0">
                                <label asp-for="Name" class="form-label-custom">Building Name <span class="text-danger">*</span></label>
                                <div class="input-icon-group">
                                    <i class="bi bi-building input-leading-icon"></i>
                                    <input asp-for="Name" class="form-control" placeholder="e.g. Skyline Commercial Tower A" autofocus />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group-custom mb-0">
                                <label asp-for="BuildingTypeId" class="form-label-custom">Classification Type <span class="text-danger">*</span></label>
                                <select asp-for="BuildingTypeId" asp-items="ViewBag.BuildingTypes" class="form-select" style="height: 48px; border-radius: 10px;">
                                    <option value="">-- Select Type --</option>
                                </select>
                                <span asp-validation-for="BuildingTypeId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Location" class="form-label-custom">Address / Physical Location <span class="text-danger">*</span></label>
                        <div class="input-icon-group">
                            <i class="bi bi-geo-alt input-leading-icon"></i>
                            <input asp-for="Location" class="form-control" placeholder="e.g. 104 Main Street, Business Bay District" />
                        </div>
                        <span asp-validation-for="Location" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check-custom my-4">
                        <input asp-for="IsActive" class="form-check-input" id="bld-active-check" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold" for="bld-active-check">Active Building Listing</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-bms-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> @(isEdit ? "Update Building" : "Save Building")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
