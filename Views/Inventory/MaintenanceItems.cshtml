@model IEnumerable<BMS.Models.Item>
@{
    ViewData["Title"] = "Maintenance Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-tools text-primary me-2"></i>Maintenance Items</h1>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Item Name</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Availability</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No maintenance items found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    <i class="bi bi-wrench text-secondary me-2"></i>@item.Name
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@(item.ItemCategory?.Name ?? "Uncategorized")</span>
                                </td>
                                <td class="text-muted text-truncate" style="max-width: 250px;" title="@item.Description">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "No description" : item.Description)
                                </td>
                                <td>
                                    @if (item.IsAvailable)
                                    {
                                        <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i> Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill"><i class="bi bi-x-circle me-1"></i> Out of Stock</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
