@using System.Reflection
@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Internal Communications & Chat";

    object? GetProp(object? obj, params string[] names)
    {
        if (obj == null) return null;
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null) return prop.GetValue(obj);
        }
        return null;
    }

    var selectedThreadId = ViewBag.SelectedThreadId ?? 1;
}

<div class="page-header-container mb-3">
    <div>
        <h1 class="page-header-title">Communications Hub</h1>
        <p class="page-header-subtitle">Direct internal messaging between staff and tenants</p>
    </div>
</div>

<div class="bms-card p-0" style="min-height: 600px;">
    <div class="row g-0 h-100">
        <!-- Sidebar: Active Threads -->
        <div class="col-md-4 col-lg-3 border-end">
            <div class="p-3 border-bottom bg-light">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Search conversations...">
                </div>
            </div>
            <div class="list-group list-group-flush overflow-auto" style="max-height: 520px;">
                @if (Model != null && Model.Any())
                {
                    foreach (var thread in Model)
                    {
                        var threadId = GetProp(thread, "Id") ?? 1;
                        var title = GetProp(thread, "Title", "Name", "SenderName")?.ToString() ?? "Tenant Conversation";
                        var lastMessage = GetProp(thread, "LastMessage", "Content", "Text")?.ToString() ?? "No messages yet";
                        var timeStr = GetProp(thread, "UpdatedAt", "Timestamp", "Date")?.ToString() ?? "Today";
                        var unread = GetProp(thread, "UnreadCount") as int? ?? 0;
                        var isActive = threadId.ToString() == selectedThreadId.ToString();

                        <a asp-action="Chat" asp-route-id="@threadId" class="list-group-item list-group-item-action border-0 py-3 px-3 @(isActive ? "bg-primary-subtle border-start border-4 border-primary" : "")">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                <h6 class="mb-0 fw-bold text-dark">@title</h6>
                                <small class="text-muted fs-7">@timeStr</small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <p class="mb-0 text-muted small text-truncate pe-2" style="max-width: 180px;">@lastMessage</p>
                                @if (unread > 0)
                                {
                                    <span class="badge bg-danger rounded-pill fs-7">@unread</span>
                                }
                            </div>
                        </a>
                    }
                }
                else
                {
                    <a href="#" class="list-group-item list-group-item-action border-0 py-3 px-3 bg-primary-subtle border-start border-4 border-primary">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h6 class="mb-0 fw-bold text-dark">Tenant #TNT-104 (Abebe)</h6>
                            <small class="text-muted fs-7">10:45 AM</small>
                        </div>
                        <p class="mb-0 text-muted small text-truncate">Regarding room unit #201 plumbing...</p>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 py-3 px-3">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h6 class="mb-0 fw-bold text-dark">Maintenance Desk</h6>
                            <small class="text-muted fs-7">Yesterday</small>
                        </div>
                        <p class="mb-0 text-muted small text-truncate">Work order #WO-89 has been resolved.</p>
                    </a>
                }
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="col-md-8 col-lg-9 d-flex flex-column bg-white">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                <div class="d-flex align-items-center">
                    <div class="avatar me-2 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-person-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Active Communication Thread</h6>
                        <small class="text-success"><i class="bi bi-circle-fill fs-7 me-1"></i> Online</small>
                    </div>
                </div>
            </div>

            <!-- Messages Window -->
            <div class="p-4 flex-grow-1 overflow-auto bg-body-tertiary" style="height: 420px;">
                <div class="d-flex flex-column gap-3">
                    <div class="align-self-start bg-white p-3 rounded-3 shadow-sm border max-w-75">
                        <small class="fw-bold text-primary mb-1 d-block">Tenant Request</small>
                        <p class="mb-1 text-dark">Hello, when will the water maintenance be finished on Floor 2?</p>
                        <small class="text-muted fs-7 d-block text-end">10:30 AM</small>
                    </div>

                    <div class="align-self-end bg-primary text-white p-3 rounded-3 shadow-sm max-w-75">
                        <small class="fw-bold text-light mb-1 d-block">Staff Response</small>
                        <p class="mb-1">Our technical crew is currently wrapping up the pipe replacement. Water service will resume in 30 minutes.</p>
                        <small class="text-light-50 fs-7 d-block text-end opacity-75">10:45 AM</small>
                    </div>
                </div>
            </div>

            <!-- Chat Input -->
            <div class="p-3 border-top bg-white">
                <form asp-action="SendMessage" method="post" class="d-flex gap-2">
                    <input type="hidden" name="ThreadId" value="@selectedThreadId" />
                    <input type="text" name="Message" class="form-control" placeholder="Type a message or response..." style="height: 46px; border-radius: 8px;" required />
                    <button type="submit" class="btn btn-bms-primary px-4">
                        <i class="bi bi-send-fill me-1"></i> Send
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>