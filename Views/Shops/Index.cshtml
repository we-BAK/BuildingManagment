@model IEnumerable<BMS.Models.Shop>

@{
    ViewData["Title"] = "Commercial Shops Directory";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Commercial Spaces & Shops</h1>
        <p class="page-header-subtitle">Manage retail shop units, storefront facades, commercial lease terms, and shop specifications</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-bms-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Register Commercial Shop
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Shop Number</th>
                        <th>Building Asset</th>
                        <th>Floor Level</th>
                        <th>Facade Type</th>
                        <th>Retail Size</th>
                        <th>Monthly Lease Price</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">No commercial shop units registered yet. Click "Register Commercial Shop" to add one.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark fs-6">Shop @s.ShopNumber</div>
                                    <small class="text-muted">ID: #SHP-@s.Id</small>
                                </td>
                                <td><span class="badge bg-light text-dark border"><i class="bi bi-building me-1"></i>@(s.Building?.Name ?? "N/A")</span></td>
                                <td>@(s.Floor?.Name ?? "Ground Level")</td>
                                <td><span class="badge bg-info-subtle text-info border">@(s.FacadeType ?? "Glass Frontage")</span></td>
                                <td>@s.Size sq ft</td>
                                <td><span class="fw-bold text-success">$@((s.Price ?? 0).ToString("N2"))/mo</span></td>
                                <td>
                                    @{
                                        var statusName = s.ShopStatus?.Name ?? "Vacant";
                                        var statusClass = statusName.ToLower().Contains("occup") ? "badge-status-occupied" : "badge-status-vacant";
                                    }
                                    <span class="badge-status @statusClass">@statusName</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-outline-primary" title="Shop Details"><i class="bi bi-eye"></i> Details</a>
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-secondary" title="Edit Shop"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Images" asp-route-id="@s.Id" class="btn btn-outline-info" title="Storefront Photos"><i class="bi bi-image"></i></a>
                                        <a asp-action="Specifications" asp-route-id="@s.Id" class="btn btn-outline-dark" title="Technical Specs (HVAC/Power)"><i class="bi bi-sliders"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
