@model BMS.Models.ViewModels.ShopDetailsViewModel

@{
    ViewData["Title"] = $"Shop {Model.Shop.ShopNumber} Details";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Shop @Model.Shop.ShopNumber</h1>
        <p class="page-header-subtitle"><i class="bi bi-building me-1"></i> @(Model.Shop.Building?.Name ?? "Building") | Status: <strong>@(Model.Shop.ShopStatus?.Name ?? "Vacant")</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Shop.Id" class="btn btn-outline-primary btn-sm rounded-3">
            <i class="bi bi-pencil me-1"></i> Edit Shop
        </a>
        <a asp-action="Images" asp-route-id="@Model.Shop.Id" class="btn btn-outline-info btn-sm rounded-3">
            <i class="bi bi-image me-1"></i> Storefront Photos
        </a>
        <a asp-action="Specifications" asp-route-id="@Model.Shop.Id" class="btn btn-outline-dark btn-sm rounded-3">
            <i class="bi bi-sliders me-1"></i> Technical Specs
        </a>
        <a asp-action="Index" class="btn btn-secondary btn-sm rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Shop Overview -->
    <div class="col-lg-4">
        <div class="bms-card mb-4">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-shop me-2 text-primary"></i> Commercial Parameters</h5>
            </div>
            <div class="bms-card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Facade Frontage</span>
                        <span class="fw-bold">@(Model.Shop.FacadeType ?? "Glass Front")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Retail Area</span>
                        <span class="fw-bold">@Model.Shop.Size sq ft</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Monthly Lease Price</span>
                        <span class="fw-bold text-success">$@((Model.Shop.Price ?? 0).ToString("N2"))</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Technical Specs Summary -->
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-cpu me-2 text-dark"></i> Technical Specs (HVAC/Power)</h5>
            </div>
            <div class="bms-card-body">
                @if (!Model.Specifications.Any())
                {
                    <p class="text-muted small mb-0">No electrical or ventilation requirements listed. <a asp-action="Specifications" asp-route-id="@Model.Shop.Id">Add Specs</a></p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var spec in Model.Specifications)
                        {
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                                <span class="text-muted">@spec.Title</span>
                                <span class="fw-semibold text-dark">@spec.Detail</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- Rental Inquiries for this Shop -->
    <div class="col-lg-8">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-inbox me-2 text-info"></i> Commercial Rental Applications</h5>
            </div>
            <div class="bms-card-body p-0">
                <div class="table-responsive">
                    <table class="bms-table">
                        <thead>
                            <tr>
                                <th>Applicant</th>
                                <th>Application Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RentalRequests.Any())
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No rental applications submitted for this shop unit yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var req in Model.RentalRequests)
                                {
                                    <tr>
                                        <td class="fw-bold">@(req.User?.FullName ?? "Applicant")</td>
                                        <td>@req.CreatedDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@(req.Status?.Name ?? "Pending")</span></td>
                                        <td><a asp-controller="RentalRequests" asp-action="Review" asp-route-id="@req.Id" asp-route-type="Shop" class="btn btn-sm btn-outline-primary">Review</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
