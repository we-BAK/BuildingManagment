@model IEnumerable<BMS.Models.Tenant>

@{
    ViewData["Title"] = "Tenant Directory";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Tenant Directory</h1>
        <p class="page-header-subtitle">Directory of active and past commercial & residential tenants, identification, and contact info</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-bms-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i> Register New Tenant
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Tenant Name</th>
                        <th>National ID / Passport</th>
                        <th>Email Contact</th>
                        <th>Phone Number</th>
                        <th>Active Contracts</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No tenants registered. Click "Register New Tenant" to add one.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in Model)
                        {
                            var activeCount = t.RoomRentals.Count(r => r.IsActive && !r.IsDeleted);
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@t.FirstName @t.MiddleName @t.LastName</div>
                                    <small class="text-muted">Tenant #TNT-@t.Id</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@t.IdentityCardNumber</span></td>
                                <td><i class="bi bi-envelope text-muted me-1"></i>@t.Email</td>
                                <td><i class="bi bi-telephone text-muted me-1"></i>@t.Phone</td>
                                <td>
                                    @if (activeCount > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border">@activeCount Active Lease(s)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">No Active Lease</span>
                                    }
                                </td>
                                <td><span class="badge-status badge-status-active">Active</span></td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-outline-secondary btn-sm rounded-2"><i class="bi bi-pencil me-1"></i> Edit Profile</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
