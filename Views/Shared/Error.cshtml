@model ErrorViewModel
@{
    ViewData["Title"] = "Application Error";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="bms-card p-5">
                <div class="mb-4">
                    <i class="bi bi-exclamation-octagon text-danger display-1"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Something went wrong</h2>
                <p class="text-muted mb-4">An unexpected error occurred while processing your request. Please try again or return to the main dashboard.</p>

                @if (Model?.ShowRequestId ?? false)
                {
                    <p class="small text-muted bg-light p-2 rounded border">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Go Back
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-bms-primary px-4">
                        <i class="bi bi-house me-1"></i> Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>