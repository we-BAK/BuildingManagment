@using System.Reflection
@model IEnumerable<BMS.Models.RentalAgreementTermination>

@{
    ViewData["Title"] = "Lease Terminations Log";

    object? GetProp(object? obj, params string[] names)
    {
        if (obj == null) return null;
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null) return prop.GetValue(obj);
        }
        return null;
    }

    string FormatDate(object? obj, params string[] propNames)
    {
        var rawVal = GetProp(obj, propNames);
        if (rawVal is DateTime dt) return dt.ToString("MMM dd, yyyy");
        return "N/A";
    }
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Lease Agreement Terminations Log</h1>
        <p class="page-header-subtitle">Track early cancellation requests, inspection findings, and official lease endings</p>
    </div>
    <div>
        <a asp-controller="Tenants" asp-action="RequestTermination" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-x-circle me-1"></i> Request Early Termination
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Termination ID</th>
                        <th>Tenant</th>
                        <th>Room Unit</th>
                        <th>Effective Date</th>
                        <th>Reason for Ending</th>
                        <th>Status</th>
                        <th class="text-end">Workflow Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No lease termination records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in Model)
                        {
                            var agreementObj = GetProp(t, "RentalAgreement", "RoomRental", "Agreement", "Lease");
                            var tenantObj = GetProp(agreementObj, "Tenant", "User") ?? GetProp(t, "Tenant", "User");
                            var roomObj = GetProp(agreementObj, "Room") ?? GetProp(t, "Room");

                            var firstName = GetProp(tenantObj, "FirstName", "Name")?.ToString();
                            var lastName = GetProp(tenantObj, "LastName")?.ToString();
                            var tenantName = !string.IsNullOrEmpty(firstName) ? $"{firstName} {lastName}".Trim() : GetProp(tenantObj, "FullName", "UserName")?.ToString() ?? "Tenant";

                            var roomNumber = GetProp(roomObj, "Name", "RoomNumber", "Number")?.ToString() ?? "N/A";
                            var terminationDateStr = FormatDate(t, "TerminationDate", "EffectiveDate", "CreatedDate", "Date", "RequestedDate");
                            var reasonText = GetProp(t, "Reason", "TerminationReason", "Notes")?.ToString() ?? "N/A";

                            var rawStatusId = GetProp(t, "StatusId", "RequestStatusId", "StateId");
                            var statusId = rawStatusId != null ? Convert.ToInt32(rawStatusId) : 1;

                            <tr>
                                <td>#TERM-@t.Id</td>
                                <td><span class="fw-bold">@tenantName</span></td>
                                <td><span class="badge bg-light text-dark border">Room @roomNumber</span></td>
                                <td>@terminationDateStr</td>
                                <td>@reasonText</td>
                                <td>
                                    @if (statusId == 2)
                                    {
                                        <span class="badge-status badge-status-approved">Approved & Vacated</span>
                                    }
                                    else if (statusId == 3)
                                    {
                                        <span class="badge-status badge-status-declined">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-pending">Pending Inspection</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (statusId == 1)
                                    {
                                        <a asp-controller="Tenants" asp-action="TerminationApproval" asp-route-id="@t.Id" class="btn btn-outline-primary btn-sm rounded-2">
                                            Inspection & Approval
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Processed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>