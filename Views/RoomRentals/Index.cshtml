@using System.Reflection
@model IEnumerable<BMS.Models.RoomRental>

@{
    ViewData["Title"] = "Active Leases & Rental Agreements";

    object? GetProp(object? obj, params string[] names)
    {
        if (obj == null) return null;
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null) return prop.GetValue(obj);
        }
        return null;
    }

    string FormatDate(object? obj, params string[] propNames)
    {
        var rawVal = GetProp(obj, propNames);
        if (rawVal is DateTime dt) return dt.ToString("MMM dd, yyyy");
        return "N/A";
    }
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Active Leases & Rental Agreements</h1>
        <p class="page-header-subtitle">Directory of binding tenant contracts, monthly rental amounts, start/end dates, and lease status</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-bms-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> New Lease Agreement
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Agreement ID</th>
                        <th>Tenant</th>
                        <th>Property Unit</th>
                        <th>Lease Term</th>
                        <th>Monthly Rent</th>
                        <th>Lease Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No active lease agreements registered yet. Click "New Lease Agreement" to create one.</td></tr>
                    }
                    else
                    {
                        @foreach (var r in Model)
                        {
                            var tenantObj = GetProp(r, "Tenant", "User");
                            var roomObj = GetProp(r, "Room");
                            var floorObj = GetProp(roomObj, "Floor");
                            var buildingObj = GetProp(roomObj, "Building") ?? GetProp(floorObj, "Building");

                            var firstName = GetProp(tenantObj, "FirstName", "Name")?.ToString();
                            var lastName = GetProp(tenantObj, "LastName")?.ToString();
                            var tenantName = !string.IsNullOrEmpty(firstName) ? $"{firstName} {lastName}".Trim() : GetProp(tenantObj, "FullName", "UserName")?.ToString() ?? "Tenant";

                            var tenantIdNum = GetProp(tenantObj, "IdentityCardNumber", "IdCardNumber", "NationalId", "IdentityNumber")?.ToString() ?? "N/A";
                            var roomNumber = GetProp(roomObj, "Name", "RoomNumber", "Number")?.ToString() ?? "N/A";
                            var buildingName = GetProp(buildingObj, "Name", "Title")?.ToString() ?? "Building";

                            var startDateStr = FormatDate(r, "StartDate", "StartFrom", "RentDate");
                            var endDateStr = FormatDate(r, "EndDate", "EndTo", "ExpiryDate", "DueDate");

                            var rawPrice = GetProp(r, "Price", "MonthlyRent", "RentAmount", "Amount", "Cost");
                            var priceVal = rawPrice != null ? Convert.ToDecimal(rawPrice) : 0m;

                            var isActiveRaw = GetProp(r, "IsActive", "Active", "Status");
                            var isActive = isActiveRaw is bool b ? b : true;

                            <tr>
                                <td>#LEASE-@r.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@tenantName</div>
                                    <small class="text-muted">ID: @tenantIdNum</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        Room @roomNumber (@buildingName)
                                    </span>
                                </td>
                                <td>@startDateStr &mdash; @endDateStr</td>
                                <td><span class="fw-bold text-success">$@priceVal.ToString("N2")/mo</span></td>
                                <td>
                                    @if (isActive)
                                    {
                                        <span class="badge-status badge-status-active"><i class="bi bi-check-circle"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-terminated"><i class="bi bi-x-circle"></i> Ended</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-outline-secondary btn-sm rounded-2"><i class="bi bi-pencil me-1"></i> Edit Lease</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>