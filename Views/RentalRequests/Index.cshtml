@using System.Reflection
@model IEnumerable<BMS.Models.RoomRentalRequest>

@{
    ViewData["Title"] = "Room Rental Applications";

    object? GetProp(object? obj, params string[] names)
    {
        if (obj == null) return null;
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null) return prop.GetValue(obj);
        }
        return null;
    }

    string FormatDate(object? obj)
    {
        var rawVal = GetProp(obj, "CeratedDate", "CreatedDate", "RequestDate", "Date", "CreatedAt", "CreatedOn");
        if (rawVal is DateTime dt) return dt.ToString("MMM dd, yyyy");
        return "N/A";
    }
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Room Rental Applications</h1>
        <p class="page-header-subtitle">Review incoming inquiries and applications for residential apartment units</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ShopRequests" class="btn btn-outline-info btn-sm">
            <i class="bi bi-shop me-1"></i> Switch to Shop Requests
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Application ID</th>
                        <th>Applicant</th>
                        <th>Target Unit</th>
                        <th>Building Asset</th>
                        <th>Submitted Date</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No room rental inquiries submitted yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var r in Model)
                        {
                            var roomObj = GetProp(r, "Room");
                            var userObj = GetProp(r, "User");
                            var buildingObj = GetProp(roomObj, "Building");
                            var statusObj = GetProp(r, "Status", "RequestStatus");

                            var applicantName = GetProp(userObj, "FullName", "Name", "UserName")?.ToString() ?? "Applicant";
                            var applicantEmail = GetProp(userObj, "Email")?.ToString() ?? "N/A";
                            var roomNumber = GetProp(roomObj, "Name", "RoomNumber", "Number")?.ToString() ?? "N/A";
                            var buildingName = GetProp(buildingObj, "Name", "Title")?.ToString() ?? "N/A";

                            var statusName = GetProp(statusObj, "Name", "Title", "StatusName")?.ToString()
                            ?? GetProp(r, "Status")?.ToString()
                            ?? "Pending";

                            var statusClass = statusName.ToLower().Contains("appr") ? "badge-status-approved" :
                            statusName.ToLower().Contains("decl") || statusName.ToLower().Contains("reje") ? "badge-status-declined" : "badge-status-pending";

                            <tr>
                                <td>#REQ-RM-@r.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@applicantName</div>
                                    <small class="text-muted">@applicantEmail</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">Room @roomNumber</span></td>
                                <td>@buildingName</td>
                                <td>@FormatDate(r)</td>
                                <td>
                                    <span class="badge-status @statusClass">@statusName</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Review" asp-route-id="@r.Id" asp-route-type="Room" class="btn btn-primary btn-sm px-3 rounded-2">
                                        <i class="bi bi-shield-check me-1"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>