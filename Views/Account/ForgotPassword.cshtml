@model BMS.Models.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-bg">
    <div class="auth-container">
        <div class="auth-card">
            <!-- Header Branding -->
            <div class="auth-header">
                <div class="auth-brand-logo">
                    <i class="bi bi-key"></i>
                </div>
                <h2>Reset Password</h2>
                <p>Enter your account email address to receive password reset instructions</p>
            </div>

            <!-- Feedback Alert Banners -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="bms-alert bms-alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill bms-alert-icon"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="bms-alert bms-alert-danger" style="display: none;"></div>

                <!-- Email Address Field -->
                <div class="form-group-custom mb-4">
                    <label asp-for="Email" class="form-label-custom">Email Address</label>
                    <div class="input-icon-group">
                        <i class="bi bi-envelope input-leading-icon"></i>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-bms-primary w-100 mb-3">
                    <i class="bi bi-send me-1"></i>
                    <span>Send Reset Instructions</span>
                </button>
            </form>

            <div class="auth-divider">
                <span>Remember your password?</span>
            </div>

            <div class="text-center">
                <a asp-action="Login" asp-controller="Account" class="auth-link">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const valSummary = document.querySelector('[asp-validation-summary="ModelOnly"]');
            if (valSummary && valSummary.children.length > 0 && valSummary.querySelector('li')) {
                valSummary.style.display = 'flex';
            }
        });
    </script>
}
