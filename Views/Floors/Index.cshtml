@model IEnumerable<BMS.Models.Floor>

@{
    ViewData["Title"] = "Floors Directory";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Floors Directory</h1>
        <p class="page-header-subtitle">Overview of building levels, floor numbers, and floor-level pricing configurations</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-bms-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Floor
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Floor Level</th>
                        <th>Building</th>
                        <th>Rooms Count</th>
                        <th>Shops Count</th>
                        <th>Base Price</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No floors configured. Click "Add New Floor" to start.</td></tr>
                    }
                    else
                    {
                        @foreach (var f in Model)
                        {
                            var latestPrice = f.FloorPrices.FirstOrDefault(fp => !fp.IsDeleted);
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@f.Name</div>
                                    <small class="text-muted">Floor Number: @f.FloorNumber</small>
                                </td>
                                <td><span class="badge bg-light text-dark border"><i class="bi bi-building me-1"></i>@(f.Building?.Name ?? "N/A")</span></td>
                                <td><span class="fw-semibold">@f.Rooms.Count</span> Rooms</td>
                                <td><span class="fw-semibold">@f.Shops.Count</span> Shops</td>
                                <td>
                                    @if (latestPrice != null)
                                    {
                                        <span class="fw-bold text-success">$@latestPrice.Price.ToString("N2")/mo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not set</span>
                                    }
                                </td>
                                <td><span class="badge-status badge-status-active">Active</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-outline-secondary" title="Edit Floor"><i class="bi bi-pencil"></i> Edit</a>
                                        <a asp-action="Prices" asp-route-id="@f.Id" class="btn btn-outline-success" title="Configure Floor Base Pricing"><i class="bi bi-currency-dollar"></i> Base Pricing</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
