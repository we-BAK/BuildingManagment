@model BMS.Models.MaintenanceRequest
@{
    ViewData["Title"] = "Submit Maintenance Request";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-plus-circle text-primary me-2"></i>Submit Maintenance Request</h1>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Requests
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="UserId" class="form-label fw-medium">Tenant / Requester <span class="text-danger">*</span></label>
                            <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users" required>
                                <option value="">-- Select User --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RoomId" class="form-label fw-medium">Room / Location <span class="text-danger">*</span></label>
                            <select asp-for="RoomId" class="form-select" asp-items="ViewBag.Rooms" required>
                                <option value="">-- Select Room --</option>
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaintenanceTypeId" class="form-label fw-medium">Issue Type <span class="text-danger">*</span></label>
                        <select asp-for="MaintenanceTypeId" class="form-select" asp-items="ViewBag.MaintenanceTypes" required>
                            <option value="">-- Select Issue Type --</option>
                        </select>
                        <span asp-validation-for="MaintenanceTypeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-medium">Description of Issue <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Please describe the issue in detail..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send me-1"></i> Submit Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
