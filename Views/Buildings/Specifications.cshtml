@model BMS.Models.ViewModels.BuildingSpecViewModel

@{
    ViewData["Title"] = $"Technical Specifications: {Model.BuildingName}";
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Technical Specifications & Attributes</h1>
        <p class="page-header-subtitle">Define energy efficiency ratings, structural parameters, and accessibility features for <strong>@Model.BuildingName</strong></p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.BuildingId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Details
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-plus-circle me-2 text-primary"></i> Add Technical Spec</h5>
            </div>
            <div class="bms-card-body">
                <form asp-action="SaveSpecification" method="post">
                    <input type="hidden" asp-for="BuildingId" />

                    <div class="form-group-custom">
                        <label asp-for="Title" class="form-label-custom">Attribute Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Energy Efficiency Rating" autofocus style="height: 48px; border-radius: 10px;" />
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Detail" class="form-label-custom">Specification Detail / Value <span class="text-danger">*</span></label>
                        <input asp-for="Detail" class="form-control" placeholder="e.g. LEED Gold Certified / Solar Powered" style="height: 48px; border-radius: 10px;" />
                    </div>

                    <button type="submit" class="btn btn-bms-primary w-100 mt-3">
                        <i class="bi bi-check-lg me-1"></i> Add Specification
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-sliders me-2 text-dark"></i> Current Specifications (@Model.Specifications.Count)</h5>
            </div>
            <div class="bms-card-body p-0">
                <div class="table-responsive">
                    <table class="bms-table">
                        <thead>
                            <tr>
                                <th>Attribute Title</th>
                                <th>Floors</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Specifications.Any())
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">No specifications defined for this building yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var spec in Model.Specifications)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@spec.Name</td>
                                        <td><span class="badge bg-light text-primary border fs-6">@spec.NumberOfFloor Floors</span></td>
                                        <td><span class="badge-status badge-status-active">Active</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>