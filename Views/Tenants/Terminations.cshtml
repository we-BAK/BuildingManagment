@using System.Reflection
@model IEnumerable<BMS.Models.RentalAgreementTermination>

@{
    ViewData["Title"] = "Rental Agreement Terminations";

    object? GetProp(object? obj, params string[] names)
    {
        if (obj == null) return null;
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null) return prop.GetValue(obj);
        }
        return null;
    }
}

<div class="page-header-container">
    <div>
        <h1 class="page-header-title">Rental Agreement Terminations</h1>
        <p class="page-header-subtitle">Manage requests and process official endings of lease agreements</p>
    </div>
    <div>
        <a asp-action="RequestTermination" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-x-circle me-1"></i> Submit Early Termination
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="bms-card">
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Termination ID</th>
                        <th>Tenant</th>
                        <th>Property Unit</th>
                        <th>Requested Date</th>
                        <th>Reason for Ending</th>
                        <th>Status</th>
                        <th class="text-end">Approval Workflow</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No termination requests recorded.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in Model)
                        {
                            var termId = GetProp(t, "Id") ?? "0";

                            var agreement = GetProp(t, "RentalAgreement", "RoomRental", "Agreement", "Lease");
                            var tenant = GetProp(agreement, "Tenant", "User", "Customer") ?? GetProp(t, "Tenant");

                            var firstName = GetProp(tenant, "FirstName", "Name", "FullName")?.ToString() ?? "";
                            var lastName = GetProp(tenant, "LastName")?.ToString() ?? "";
                            var tenantName = $"{firstName} {lastName}".Trim();

                            if (string.IsNullOrWhiteSpace(tenantName))
                            {
                                var userObj = GetProp(tenant, "User", "ApplicationUser");
                                tenantName = GetProp(userObj, "FullName", "UserName", "Email")?.ToString() ?? "Tenant";
                            }

                            var room = GetProp(agreement, "Room", "Shop");
                            var roomNum = GetProp(room, "RoomNumber", "ShopNumber", "Number", "Name", "Code")?.ToString() ?? "N/A";

                            var rawDate = GetProp(t, "TerminationDate", "RequestedTerminationDate", "RequestedDate", "CreatedDate", "CreatedAt");
                            var formattedDate = rawDate is DateTime dt ? dt.ToString("MMM dd, yyyy") : (rawDate?.ToString() ?? "N/A");

                            var reason = GetProp(t, "Reason", "Notes", "Description")?.ToString() ?? "N/A";

                            var rawStatus = GetProp(t, "StatusId", "Status", "TerminationStatus", "State");
                            int statusId = 1;
                            if (rawStatus is int sInt)
                            {
                                statusId = sInt;
                            }
                            else if (rawStatus != null)
                            {
                                var statusStr = rawStatus.ToString()?.ToLower() ?? "";
                                if (statusStr.Contains("approved") || statusStr.Contains("completed")) statusId = 2;
                                else if (statusStr.Contains("declined") || statusStr.Contains("rejected")) statusId = 3;
                            }

                            <tr>
                                <td>#TERM-@termId</td>
                                <td><span class="fw-bold">@tenantName</span></td>
                                <td><span class="badge bg-light text-dark border">Room @roomNum</span></td>
                                <td>@formattedDate</td>
                                <td>@reason</td>
                                <td>
                                    @if (statusId == 2)
                                    {
                                        <span class="badge-status badge-status-approved">Approved & Vacated</span>
                                    }
                                    else if (statusId == 3)
                                    {
                                        <span class="badge-status badge-status-declined">Declined</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-pending">Pending Staff Review</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (statusId == 1)
                                    {
                                        <a asp-action="TerminationApproval" asp-route-id="@termId" class="btn btn-primary btn-sm px-3 rounded-2">
                                            Review Approval
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>