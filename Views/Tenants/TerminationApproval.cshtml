@model BMS.Models.ViewModels.TerminationApprovalViewModel

@{
    ViewData["Title"] = $"Termination Approval #{Model.TerminationId}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-header-container">
            <div>
                <h1 class="page-header-title">Process Lease Termination</h1>
                <p class="page-header-subtitle">Review move-out inspection remarks and approve/decline lease ending</p>
            </div>
            <div>
                <a asp-action="Terminations" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Terminations
                </a>
            </div>
        </div>

        <div class="bms-card mb-4">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-info-circle me-2 text-primary"></i> Termination Request Info</h5>
            </div>
            <div class="bms-card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Tenant Name</small>
                        <div class="fw-bold fs-6 text-dark">@Model.TenantName</div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Property Unit</small>
                        <div class="fw-bold fs-6 text-primary">Room @Model.RoomNumber</div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Requested Termination Date</small>
                        <div class="fw-semibold">@Model.RequestedDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Stated Reason for Leaving</small>
                        <div class="p-3 bg-light rounded-3 border mt-1">@Model.Reason</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-clipboard-check me-2 text-dark"></i> Inspection & Approval Form</h5>
            </div>
            <div class="bms-card-body">
                <form asp-action="ProcessTermination" method="post">
                    <input type="hidden" name="terminationId" value="@Model.TerminationId" />

                    <div class="form-group-custom">
                        <label for="approvalNotes" class="form-label-custom">Move-Out Inspection Remarks & Notes</label>
                        <textarea id="approvalNotes" name="approvalNotes" class="form-control" rows="3" placeholder="Record key inspection findings, deposit deduction notes, or condition remarks..."></textarea>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" name="approved" value="true" class="btn btn-success flex-grow-1 py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Approve & Vacate Unit
                        </button>
                        <button type="submit" name="approved" value="false" class="btn btn-outline-danger flex-grow-1 py-2 fw-semibold">
                            <i class="bi bi-x-circle me-1"></i> Reject Termination
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
