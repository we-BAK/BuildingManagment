@model BMS.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Floor and Room Details Section -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-layers me-2 text-primary"></i> Floor Overview</h5>
            </div>
            <div class="bms-card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var floor in Model.Floors)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold">@floor.Name</span>
                                <small class="text-muted d-block">Building: @(floor.Building?.Name ?? "N/A")</small>
                            </div>
                            <span class="badge bg-primary rounded-pill">@floor.Rooms.Count Rooms</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="bms-card">
            <div class="bms-card-header">
                <h5 class="bms-card-title"><i class="bi bi-door-open me-2 text-info"></i> Room Rental Requests</h5>
            </div>
            <div class="bms-card-body p-0">
                <div class="table-responsive">
                    <table class="bms-table">
                        <thead>
                            <tr>
                                <th>Room</th>
                                <th>Building</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.RoomRentalRequests)
                            {
                                <tr>
                                    <td>@(request.Room?.Name ?? $"Room #{request.RoomId}")</td>
                                    <td>@(request.Room?.Floor?.Building?.Name ?? "N/A")</td>
                                    <td>@request.CeratedDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-secondary">@(request.RequestStatus?.Name ?? "Pending")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Active Rooms List Section -->
<div class="bms-card mb-4">
    <div class="bms-card-header">
        <h5 class="bms-card-title"><i class="bi bi-grid me-2 text-dark"></i> Rooms Directory</h5>
    </div>
    <div class="bms-card-body p-0">
        <div class="table-responsive">
            <table class="bms-table">
                <thead>
                    <tr>
                        <th>Room Name</th>
                        <th>Date Added</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td class="fw-bold">@room.Name</td>
                            <td>@room.CeratedDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Notifications Section -->
<div class="bms-card">
    <div class="bms-card-header">
        <h5 class="bms-card-title"><i class="bi bi-bell me-2 text-warning"></i> Recent System Notifications</h5>
    </div>
    <div class="bms-card-body p-0">
        <div class="list-group list-group-flush">
            @foreach (var notif in Model.Notifications)
            {
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 fw-bold text-dark">@notif.Name</h6>
                        <small class="text-muted">@notif.CeratedDate.ToString("g")</small>
                    </div>
                    <p class="mb-1 text-secondary small">@notif.Description</p>
                </div>
            }
        </div>
    </div>
</div>